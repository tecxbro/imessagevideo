{
  "title": "CAPABILITY TEST — not a reference recreation",
  "width": 640,
  "height": 360,
  "fps": 30,
  "duration": 1,
  "background": "#eff2f6",
  "layers": [
    {
      "id": "notice",
      "type": "text",
      "text": "RENDER CAPABILITY TEST",
      "x": 32,
      "y": 22,
      "fontFamily": "Arial, sans-serif",
      "fontSize": 20,
      "fontWeight": 700,
      "fill": "#293444"
    },
    {
      "id": "bubble",
      "type": "group",
      "x": 180,
      "y": 120,
      "keyframes": {
        "x": [
          {
            "t": 0,
            "value": 120
          },
          {
            "t": 0.6,
            "value": 180,
            "ease": "easeOut"
          }
        ],
        "opacity": [
          {
            "t": 0,
            "value": 0
          },
          {
            "t": 0.3,
            "value": 1
          }
        ]
      },
      "children": [
        {
          "id": "bubble-shape",
          "type": "rect",
          "width": 280,
          "height": 100,
          "radius": 34,
          "fill": "#1688ff"
        },
        {
          "id": "bubble-text",
          "type": "text",
          "text": "Measured motion",
          "x": 25,
          "y": 30,
          "fontSize": 26,
          "fontFamily": "Arial, sans-serif",
          "fill": "#ffffff"
        }
      ]
    },
    {
      "id": "dot",
      "type": "circle",
      "x": 305,
      "y": 260,
      "width": 24,
      "height": 24,
      "fill": "#222222",
      "keyframes": {
        "scaleX": [
          {
            "t": 0,
            "value": 0.5
          },
          {
            "t": 1,
            "value": 1
          }
        ],
        "scaleY": [
          {
            "t": 0,
            "value": 0.5
          },
          {
            "t": 1,
            "value": 1
          }
        ]
      }
    }
  ]
}
