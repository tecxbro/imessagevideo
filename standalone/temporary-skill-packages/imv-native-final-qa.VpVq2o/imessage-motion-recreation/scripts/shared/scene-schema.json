{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Measured motion scene v1",
  "type": "object",
  "required": [
    "width",
    "height",
    "fps",
    "duration",
    "layers"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "number",
      "minimum": 1
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "background": {
      "type": "string",
      "default": "#ffffff"
    },
    "source": {
      "type": "object",
      "description": "Reference path, sourceStart/sourceEnd in seconds, and notes. Output t=0 corresponds to sourceStart."
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "fonts": {
      "type": "array",
      "description": "Local font registration in all verified engines; provide verified font files, with native adapters resolving the declared family and weight.",
      "items": {
        "type": "object",
        "required": [
          "family",
          "src"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "weight": {},
          "style": {
            "type": "string"
          }
        }
      }
    },
    "gradients": {
      "type": "array",
      "description": "Browser SVG engines: id,type(linear/radial), x1/y1/x2/y2 or cx/cy/r (percent strings), stops:[{offset,color,opacity}]. Use fill:url(#id)."
    }
  },
  "$defs": {
    "keyframe": {
      "type": "object",
      "required": [
        "t",
        "value"
      ],
      "properties": {
        "t": {
          "type": "number"
        },
        "value": {},
        "ease": {
          "type": "string",
          "description": "Ease on arrival at this keyframe: linear (default), hold, easeIn, easeOut, easeInOut, cubic-bezier(x1,y1,x2,y2)"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "rect",
            "circle",
            "text",
            "image",
            "path",
            "group"
          ]
        },
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "default": 1
        },
        "rotation": {
          "type": "number",
          "default": 0
        },
        "scaleX": {
          "type": "number",
          "default": 1
        },
        "scaleY": {
          "type": "number",
          "default": 1
        },
        "originX": {
          "type": "number",
          "default": 0
        },
        "originY": {
          "type": "number",
          "default": 0
        },
        "start": {
          "type": "number",
          "default": 0
        },
        "end": {
          "type": "number",
          "description": "Exclusive layer end; defaults to scene duration"
        },
        "text": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string",
          "default": "Arial, sans-serif"
        },
        "fontSize": {
          "type": "number",
          "default": 32
        },
        "fontWeight": {},
        "lineHeight": {
          "type": "number",
          "description": "Pixels, defaults to 1.2 \u00d7 fontSize"
        },
        "textAnchor": {
          "enum": [
            "start",
            "middle",
            "end"
          ]
        },
        "letterSpacing": {
          "type": "number"
        },
        "src": {
          "type": "string",
          "description": "Absolute file path or data URI. Relative paths resolve against manifest directory."
        },
        "d": {
          "type": "string",
          "description": "SVG path data, own coordinate space"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "keyframes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/keyframe"
            }
          },
          "description": "Absolute OUTPUT seconds; numeric layer properties or fill/stroke. Times sorted ascending. Ease belongs to destination keyframe. Animate transforms on groups for layered elements."
        },
        "blur": {
          "type": "number",
          "minimum": 0
        },
        "clip": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "radius": {
              "type": "number"
            }
          }
        },
        "shadow": {
          "type": "object",
          "description": "Browser SVG engines: x,y,blur,color; CSS drop-shadow. Animated transforms still apply."
        },
        "textDecoration": {
          "enum": [
            "none",
            "underline",
            "line-through"
          ],
          "description": "Browser SVG only."
        }
      }
    }
  }
}
