{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directed motion shot plan",
  "type": "object",
  "required": ["mode", "promise", "fps", "shots"],
  "properties": {
    "mode": {"enum": ["exact-reference", "original-direction", "component-port"]},
    "promise": {"type": "string", "minLength": 1},
    "fps": {"type": "number", "minimum": 1},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "intent", "motif", "start_frame", "end_frame_exclusive", "components", "evidence_kind", "reading_hold_frames", "sound_events", "validation"], "properties": {
      "id": {"type": "string"}, "intent": {"type": "string"}, "motif": {"type": "string"},
      "start_frame": {"type": "integer", "minimum": 0}, "end_frame_exclusive": {"type": "integer", "minimum": 1},
      "components": {"type": "array", "items": {"type": "string"}},
      "evidence_kind": {"enum": ["measured-reference", "authored-adaptation"]},
      "reading_hold_frames": {"type": "integer", "minimum": 0}, "sound_events": {"type": "array"},
      "validation": {"type": "string"}
    }}}
  }
}
